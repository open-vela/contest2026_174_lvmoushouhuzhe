/****************************************************************************
 * board/esp32p4-function-ev-board/include/board_secrets.h.example
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * 模板文件。复制为 board_secrets.h 并填入真实值：
 *
 *   cp board_secrets.h.example board_secrets.h
 *
 * board_secrets.h 已被仓库根目录的 .gitignore 排除，切勿提交。
 * 引用方式（任意源文件均可）：
 *
 *   #include <arch/board/board_secrets.h>
 *
 * 之所以放在板级 include/ 下：构建时 <build>/include/arch/board 会符号链接到
 * vendor/espressif/boards/esp32p4/esp32p4-function-ev-board/include，
 * 而该路径又链接到本目录。于是凭据实体只存在于本仓库，
 * nuttx/ 与 apps/ 中不出现任何凭据字符。
 *
 ****************************************************************************/

#ifndef __BOARD_ESP32P4_FUNCTION_EV_BOARD_INCLUDE_BOARD_SECRETS_H
#define __BOARD_ESP32P4_FUNCTION_EV_BOARD_INCLUDE_BOARD_SECRETS_H

/****************************************************************************
 * Pre-processor Definitions
 ****************************************************************************/

/* Wi-Fi STA 凭据（M4 阶段使用） */

#define BOARD_WIFI_SSID      "your-ssid"
#define BOARD_WIFI_PASSWORD  "your-password"

/* 小米 MiMo API。HOST 与 PORT 已是正确值，通常无需修改。 */

#define BOARD_MIMO_HOST      "token-plan-cn.xiaomimimo.com"
#define BOARD_MIMO_PORT      "443"
#define BOARD_MIMO_API_KEY   "tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

#endif /* __BOARD_ESP32P4_FUNCTION_EV_BOARD_INCLUDE_BOARD_SECRETS_H */
